# Never commit real values. Production values live in Dokploy environment.
# Self-hosted Supabase (supabase-pospay)
SUPABASE_URL=https://supabse.pospay.systems
SUPABASE_PUBLISHABLE_KEY=
# Postgres connection used by server code through pg + withUser()
DATABASE_URL=postgresql://postgres:CHANGE_ME@supabse.pospay.systems:5432/postgres
# Disposable local test database only (127.0.0.1, database pospay_test)
POSPAY_TEST_DATABASE_URL=postgresql://pospay_test@127.0.0.1:55432/pospay_test
# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://app.pospay.example
# WhatsApp OTP provider (D-16) — provider to be chosen
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# Platform connector vault (AES-256-GCM). Generate: openssl rand -base64 32
PLATFORM_SECRETS_KEY=
